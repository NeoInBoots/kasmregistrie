{
  "friendly_name": "Evil-GoPhish",
  "image_src": "evilginx2.png",
  "description": "Evilginx is a man-in-the-middle attack framework used for phishing login credentials along with session cookies, which in turn allows to bypass 2-factor authentication protection.",
  "name": "cmndcntrl/evilgophish-rtpi",
  "cores": 2,
  "memory": 2768,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "docker_registry": "https://index.docker.io/v1/",
  "categories": [
    "Productivity"
  ],
  "require_gpu": false,
  "enabled": true,
  "image_type": "Container",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "first_launch": {
      "cmd": "bash -c 'cd /opt/evilhophish/' && bash -c './evilginx3 -g /opt/evilgophish/gophish/gophish.db -p legacy_phishlets'"
    },
    "go": {
      "cmd": "bash -c 'cd /opt/evilhophish/gophish' && bash -c './gophish'"
    }
  },
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    "1.13.x",
    "1.14.x"
  ],
  "uncompressed_size_mb": 2170
}